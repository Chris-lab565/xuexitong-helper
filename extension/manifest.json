{
  "manifest_version": 3,
  "name": "学习通助手",
  "version": "1.2.10",
  "permissions": [
    "cookies",
    "activeTab",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*.chaoxing.com/*",
    "*://*.xuexitong.com/*",
    "https://chris-lab565.github.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.chaoxing.com/*",
        "*://*.xuexitong.com/*",
        "https://chris-lab565.github.io/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://chris-lab565.github.io/*"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "学习通助手"
  }
}
